{
  "openapi": "3.0.0",
  "info": {
    "title": "FleetOps API",
    "version": "1.0.0",
    "description": "Complete API documentation for the FleetOps transport operations platform."
  },
  "paths": {
    "/api/v1/trips": {
      "get": {
        "summary": "Get all trips",
        "tags": ["Trips"],
        "responses": {
          "200": { "description": "List of all trips" }
        }
      },
      "post": {
        "summary": "Create a new trip",
        "tags": ["Trips"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reg_no": { "type": "string", "example": "VAN-05" },
                  "driver_id": { "type": "integer", "example": 1 },
                  "src": { "type": "string", "example": "Gandhinagar Depot" },
                  "dest": { "type": "string", "example": "Ahmedabad Hub" },
                  "cargo_weight": { "type": "number", "example": 450 },
                  "trip_dist": { "type": "number", "example": 38 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Trip successfully created" },
          "400": { "description": "Validation Error (e.g. Double booking)" }
        }
      }
    },
    "/api/v1/trips/{id}/status": {
      "put": {
        "summary": "Update a trip's status",
        "tags": ["Trips"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "trip_status": { "type": "string", "enum": ["Draft", "Dispatched", "Completed", "Cancelled"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Status updated successfully" }
        }
      }
    },
    "/api/v1/vehicles": {
      "get": {
        "summary": "Get all vehicles",
        "tags": ["Vehicles"],
        "responses": {
          "200": { "description": "List of all vehicles" }
        }
      },
      "post": {
        "summary": "Register a new vehicle",
        "tags": ["Vehicles"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reg_no": { "type": "string", "example": "TRUCK-99" },
                  "vehicle_model": { "type": "string", "example": "Volvo FH16" },
                  "type": { "type": "string", "example": "Heavy Truck" },
                  "load_capacity": { "type": "number", "example": 15000 },
                  "cost": { "type": "number", "example": 120000 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Vehicle created successfully" }
        }
      }
    },
    "/api/v1/drivers": {
      "get": {
        "summary": "Get all drivers",
        "tags": ["Drivers"],
        "responses": {
          "200": { "description": "List of all drivers" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "User login",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "alex@fleetops.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful (Returns JWT Token)" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/kpi": {
      "get": {
        "summary": "Get KPI Dashboard Metrics",
        "tags": ["KPI"],
        "responses": {
          "200": { "description": "KPI Metrics retrieved" }
        }
      }
    }
  }
}